+#ifdef _WIN32
+/*
+ * A Windows program receives its command line converted to the legacy ANSI code page, but UxPlay expects UTF-8 (it rejects other
+ * strings, so a server name like "Buero-PC" with an umlaut would end the program at start). Rebuild the arguments from the
+ * Unicode command line as UTF-8.
+ */
+static char **utf8_arguments(int *argc_out) {
+    int wargc = 0;
+    LPWSTR *wargv = CommandLineToArgvW(GetCommandLineW(), &wargc);
+    if (!wargv) return NULL;
+    char **out = (char **) calloc(wargc + 1, sizeof(char *));
+    for (int k = 0; k < wargc; k++) {
+        int len = WideCharToMultiByte(CP_UTF8, 0, wargv[k], -1, NULL, 0, NULL, NULL);
+        out[k] = (char *) malloc(len > 0 ? len : 1);
+        if (len > 0) WideCharToMultiByte(CP_UTF8, 0, wargv[k], -1, out[k], len, NULL, NULL); else out[k][0] = 0;
+    }
+    LocalFree(wargv);
+    *argc_out = wargc;
+    return out;
+}
+#endif
