+#ifdef _WIN32
+/*
+ * Title and icon of the video window. The d3d11 video sink creates its window (class "GSTD3D11") with a fixed title and the
+ * default icon. The process gives its own window the title from -wt and the icon embedded in uxplay.exe (resource 1), so that
+ * no other program has to modify the window from outside.
+ */
+/* BRAND-BEGIN (this block is also compiled by tools/build-engine/tests/window_brand_test.cpp) */
+static BOOL CALLBACK brand_window_cb(HWND hwnd, LPARAM) {
+    static HWND branded = NULL;
+    static HICON icon_big = NULL, icon_small = NULL;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (pid != GetCurrentProcessId() || !IsWindowVisible(hwnd)) return TRUE;
+    char cls[64] = {0};
+    if (!GetClassNameA(hwnd, cls, sizeof cls) || strcmp(cls, "GSTD3D11") != 0) return TRUE;
+    wchar_t cur[256] = {0};
+    GetWindowTextW(hwnd, cur, 256);
+    if (wcscmp(cur, window_title_w.c_str()) != 0) SetWindowTextW(hwnd, window_title_w.c_str());
+    if (hwnd != branded) {
+        HMODULE self = GetModuleHandleW(NULL);
+        if (!icon_big) icon_big = (HICON) LoadImageW(self, MAKEINTRESOURCEW(1), IMAGE_ICON, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON), 0);
+        if (!icon_small) icon_small = (HICON) LoadImageW(self, MAKEINTRESOURCEW(1), IMAGE_ICON, GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON), 0);
+        if (icon_big) SendMessageW(hwnd, WM_SETICON, ICON_BIG, (LPARAM) icon_big);
+        if (icon_small) SendMessageW(hwnd, WM_SETICON, ICON_SMALL, (LPARAM) icon_small);
+        branded = hwnd;
+    }
+    return TRUE;
+}
+
+static void *brand_window_thread(void *) {
+    for (;;) {
+        Sleep(500);
+        EnumWindows(brand_window_cb, 0);
+    }
+    return NULL;
+}
+/* BRAND-END */
+
+/* In the detailed log (-d) stdout is buffered for speed; flush it ten times a second so a program reading the pipe is never far behind. */
+static void *flush_stdout_thread(void *) {
+    for (;;) {
+        Sleep(100);
+        fflush(stdout);
+    }
+    return NULL;
+}
+#endif
