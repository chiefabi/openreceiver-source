+/* The sender answers a resend request for a packet it never sent (for example during a pause) with an
+ * empty "no data" packet. Record that seqnum as received-but-empty, so playback does not wait for it. */
+int
+raop_buffer_enqueue_empty(raop_buffer_t *raop_buffer, unsigned short seqnum) {
+    assert(raop_buffer);
+
+    if (raop_buffer->is_empty) {
+        return 0;     /* nothing buffered yet: nothing to wait for */
+    }
+    if (seqnum_cmp(seqnum, raop_buffer->first_seqnum) < 0) {
+        return 0;     /* already passed */
+    }
+    if (seqnum_cmp(seqnum, raop_buffer->first_seqnum + RAOP_BUFFER_LENGTH) >= 0) {
+        return 0;     /* outside the buffer window */
+    }
+    raop_buffer_entry_t *entry = &raop_buffer->entries[seqnum % RAOP_BUFFER_LENGTH];
+    if (entry->filled && seqnum_cmp(entry->seqnum, seqnum) == 0) {
+        return 0;     /* we already have this packet */
+    }
+    if (entry->payload_data) {
+        free(entry->payload_data);
+    }
+    entry->seqnum = seqnum;
+    entry->rtp_timestamp = 0;
+    entry->filled = 1;
+    entry->payload_data = NULL;
+    entry->payload_size = 0;
+    if (seqnum_cmp(seqnum, raop_buffer->last_seqnum) > 0) {
+        raop_buffer->last_seqnum = seqnum;
+    }
+    return 1;
+}
