diff -ruN pa/netstats.h pb/netstats.h
--- pa/netstats.h	1970-01-01 01:00:00.000000000 +0100
+++ pb/netstats.h	2026-10-14 22:12:20.589945900 +0200
@@ -0,0 +1,79 @@
+/*
+ * netstats.h - einfache Zähler für Datenraten (Video, Ton, Wiederholungs-Anfragen, verworfene Bilder).
+ * Einmal pro Sekunde entsteht daraus eine "STATS"-Zeile, die von der Oberfläche des OpenReceiver
+ * ausgewertet wird (Fehlersuche bei hängendem Bild).
+ *
+ * Felder: c=Verbindungen, vf/vk=Video Bilder/s und kbit/s, vmin/vavg=Reserve (kleinste/mittlere) in ms, af/ak=Ton Pakete/s
+ * und kbit/s, amin/aavg=Reserve, rs=Wiederholungs-Anfragen, re=leere Antworten darauf, gp=aufgegebene Lücken,
+ * ds/dd=verworfene Bilder (Videosenke/Decoder). Die Zeile bleibt unter 110 Zeichen (Konsolenbreite 120).
+ *
+ * Reserve in Millisekunden, mit der ein Paket VOR seiner Anzeigezeit eintrifft (positiv = rechtzeitig,
+ * negativ = zu spät). Sinkt sie unter 0, werden Bilder bzw. Ton zu spät und können verworfen werden.
+ */
+#ifndef NETSTATS_H
+#define NETSTATS_H
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <mutex>
+#include <climits>
+
+class NetStats {
+public:
+    struct Window {
+        uint64_t count = 0, bytes = 0, marg_n = 0;
+        int64_t marg_min = INT64_MAX, marg_sum = 0;
+        void add(uint64_t nbytes, int64_t margin_ns) {
+            count++; bytes += nbytes;
+            int64_t ms = margin_ns / 1000000;
+            marg_n++; marg_sum += ms; if (ms < marg_min) marg_min = ms;
+        }
+    };
+
+    void video(uint64_t bytes, int64_t margin_ns) { std::lock_guard<std::mutex> g(m_); v_.add(bytes, margin_ns); }
+    void audio(uint64_t bytes, int64_t margin_ns) { std::lock_guard<std::mutex> g(m_); a_.add(bytes, margin_ns); }
+
+    /*
+     * Liefert die STATS-Zeile für das vergangene Intervall und beginnt ein neues. Die übrigen Werte sind laufende
+     * Gesamtzahlen; daraus werden die Änderungen im Intervall berechnet. Leere Zeichenkette, wenn nichts los war.
+     */
+    std::string line(double seconds, uint64_t resend_total, uint64_t resend_empty_total, uint64_t gaps_skipped_total,
+                     uint64_t drop_sink_total, uint64_t drop_dec_total, unsigned conns) {
+        Window v, a;
+        { std::lock_guard<std::mutex> g(m_); v = v_; a = a_; v_ = Window(); a_ = Window(); }
+        uint64_t d_resend = delta(resend_total, p_resend_), d_empty = delta(resend_empty_total, p_empty_),
+                 d_gaps = delta(gaps_skipped_total, p_gaps_), d_sink = delta(drop_sink_total, p_sink_),
+                 d_dec = delta(drop_dec_total, p_dec_);
+        bool quiet = v.count == 0 && a.count == 0 && d_resend == 0 && d_empty == 0 && d_gaps == 0 && d_sink == 0 && d_dec == 0;
+        if (seconds <= 0.0 || (conns == 0 && quiet)) return std::string();
+
+        char vm[48], am[48], buf[512];
+        fmt_margin(vm, sizeof vm, "v", v); fmt_margin(am, sizeof am, "a", a);
+        snprintf(buf, sizeof buf,
+                 "STATS c=%u vf=%.1f vk=%.0f %s af=%.1f ak=%.0f %s rs=%llu re=%llu gp=%llu ds=%llu dd=%llu",
+                 conns, v.count / seconds, v.bytes * 8.0 / 1000.0 / seconds, vm,
+                 a.count / seconds, a.bytes * 8.0 / 1000.0 / seconds, am,
+                 (unsigned long long) d_resend, (unsigned long long) d_empty, (unsigned long long) d_gaps,
+                 (unsigned long long) d_sink, (unsigned long long) d_dec);
+        return std::string(buf);
+    }
+
+private:
+    static uint64_t delta(uint64_t total, uint64_t &prev) {
+        uint64_t d = total >= prev ? total - prev : total;   // Zähler wurde zurückgesetzt: neu beginnen
+        prev = total;
+        return d;
+    }
+    static void fmt_margin(char *out, size_t n, const char *prefix, const Window &w) {
+        if (w.marg_n == 0) { snprintf(out, n, "%smin=na %savg=na", prefix, prefix); return; }
+        snprintf(out, n, "%smin=%lld %savg=%lld", prefix, (long long) w.marg_min, prefix,
+                 (long long) (w.marg_sum / (int64_t) w.marg_n));
+    }
+
+    std::mutex m_;
+    Window v_, a_;
+    uint64_t p_resend_ = 0, p_empty_ = 0, p_gaps_ = 0, p_sink_ = 0, p_dec_ = 0;
+};
+
+#endif /* NETSTATS_H */
