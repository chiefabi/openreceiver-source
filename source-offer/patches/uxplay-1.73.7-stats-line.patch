+/* Data-rate statistics: one "STATS" line per second (read by the OpenReceiver user interface) */
+static NetStats *net_stats = new NetStats();    /* never freed: also used while the process shuts down */
+
+static void *net_stats_thread(void *) {
+    uint64_t last = get_local_time();
+    for (;;) {
+        Sleep(1000);
+        uint64_t now = get_local_time();
+        double secs = (double) (now - last) / SECOND_IN_NSECS;
+        last = now;
+        unsigned int drop_sink = 0, drop_dec = 0;
+        if (use_video) video_renderer_get_drops(&drop_sink, &drop_dec);
+        std::string line = net_stats->line(secs, raop_stat_resend_requests, raop_stat_resend_empty, raop_stat_gaps_skipped,
+                                           drop_sink, drop_dec, open_connections);
+        if (!line.empty()) {
+            fprintf(stderr, "%s\n", line.c_str());
+            fflush(stderr);
+        }
+    }
+    return NULL;
+}
