+
 static gboolean gstreamer_video_pipeline_bus_callback(GstBus *bus, GstMessage *message, void *loop) {
     GstState old_state, new_state;
     const gchar no_state[] = "";
@@ -1032,6 +1039,23 @@
         }
         break;
 #endif
+    case GST_MESSAGE_QOS:
+        {
+            /* the dropped counters are running totals of the reporting element (sink or decoder) */
+            GstFormat qos_format;
+            guint64 qos_processed = 0, qos_dropped = 0;
+            gst_message_parse_qos_stats(message, &qos_format, &qos_processed, &qos_dropped);
+            if (qos_dropped != (guint64) -1 && GST_IS_ELEMENT(GST_MESSAGE_SRC(message))) {
+                GstElementFactory *factory = gst_element_get_factory(GST_ELEMENT(GST_MESSAGE_SRC(message)));
+                const gchar *klass = factory ? gst_element_factory_get_metadata(factory, GST_ELEMENT_METADATA_KLASS) : NULL;
+                if (klass && strstr(klass, "Decoder")) {
+                    g_atomic_int_set(&qos_dropped_decoder, (unsigned int) qos_dropped);
+                } else {
+                    g_atomic_int_set(&qos_dropped_sink, (unsigned int) qos_dropped);
+                }
+            }
+        }
+        break;
     default:
       /* unhandled message */
         break;
