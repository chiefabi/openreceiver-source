+static unsigned int qos_dropped_sink = 0, qos_dropped_decoder = 0;
+
+void video_renderer_get_drops(unsigned int *sink, unsigned int *decoder) {
+    *sink = g_atomic_int_get(&qos_dropped_sink);
+    *decoder = g_atomic_int_get(&qos_dropped_decoder);
